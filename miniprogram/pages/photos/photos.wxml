<!--pages/photos/photos.wxml-->
<swiper
    autoplay="{{autoplay}}" 
    interval="{{interval}}" 
    duration="{{duration}}" 
    circular="{{circular}}"
    class="tm-photos-swiper"
    bindchange="onSwiperChange"

    current="{{albumIndexTarget}}">
    <block wx:for="{{photos}}" wx:for-item="photo" wx:key="id" wx:for-index="index">
      <swiper-item class="{{activeIndex === index ? 'active' : 'quiet'}}">
        <photo 
          id="photos--{{photo.id}}" 
          photoId="{{photo.id}}" 
          title="{{photo.title}}" 
          subTitle="{{photo.subTitle}}" 
          photoUrl="{{photo.imageUrl}}" 
          description="{{photo.description}}" 
          photoUrls="{{photoUrls}}" 
          photoOrientation="{{photo.orientation}}" 
          index="{{index}}" 
          bind:onDeletedPhoto="receivePhotoDelete">
        </photo>
      </swiper-item>
    </block>
  </swiper>