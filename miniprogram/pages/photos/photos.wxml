<!--pages/photos/photos.wxml-->
<swiper
  autoplay="{{autoplay}}" 
  interval="{{interval}}" 
  duration="{{duration}}" 
  circular="{{circular}}"
  class="tm-photos-swiper {{apearAnimationClass}} {{showAppearAnimation ? 'tm-photos-swiper-appear-animation' : '' }}"
  bindchange="onSwiperChange"

  current="{{albumIndexTarget}}">
  <block wx:for="{{photos}}" wx:for-item="photo" wx:key="id" wx:for-index="index">
    <swiper-item class="{{activeIndex === index ? 'tm-photos-swiper-item-active' : 'tm-photos-swiper-item-quiet'}}">
      <photo 
        id="photos--{{photo.id}}" 
        photoId="{{photo.id}}" 
        title="{{photo.title}}" 
        subTitle="{{photo.subTitle}}" 
        photoUrl="{{photo.imageUrl}}" 
        description="{{photo.description}}" 
        photoUrls="{{photoUrls}}" 
        photoOrientation="{{photo.orientation}}" 
        index="{{index}}" 
        bind:onDeletedPhoto="receivePhotoDelete">
      </photo>
    </swiper-item>
  </block>
</swiper>

<photos-bottom-menu 
  style="pointer-events: none;"
  sum="{{photos.length}}"
  index="{{activeIndex + 1}}">
</photos-bottom-menu>

<view 
  class="tm-photos-gradient-overlay {{apearAnimationClass}}" 
  wx:if="{{showAppearAnimation}}">
</view>

<view 
  class="tm-photos-open-album-mask {{openAlbumMaskShown ? '' : 'fadeOut'}}">
</view>

<view class="tm-photos-menu-bar" style="line-height: {{menuHeight}}px; right: {{menuLeft + 10}}px; top: {{menuTop}}px;">

  <view class="tm-photos-home" style="line-height: {{menuHeight}}px; border-radius: {{menuHeight / 2}}px; height: {{menuHeight}}px; padding-left: {{menuHeight / 2}}px; padding-right: {{menuHeight / 2}}px;">
    <!-- <image src="/assets/icons/home.svg" class="tm-photos-menu-bar-icon"></image> -->
    <text class="tm-photos-menu-bar-text">首页</text>
  </view>

  <view class="tm-photos-add-button" style="line-height: {{menuHeight}}px; border-radius: {{menuHeight / 2}}px; height: {{menuHeight}}px; width: {{menuHeight}}px;">
    <image src="/assets/icons/add.svg" class="tm-photos-menu-bar-icon"></image>
  </view>
  
</view>
