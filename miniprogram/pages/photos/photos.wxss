/* pages/photos/photos.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: black;
}

.tm-photos-swiper {
  width: 100vw;
  height: 100vh;
}

.active {
  opacity: 1;
  /* filter: blur(0); */
  transition: all 1s ease-out;
}

.quiet {
  opacity: 0;
  /* filter: blur(5px); */
  transition: all 1s ease-out;
}
