/* components/photo-creation/photo-creation.wxss */
/* components/photo-creation/photo-creation.wxss */
.photo-creation-root {
  height: 100vh;
  width: 100vw;
  background-color: rgb(255, 255, 255);
  position: absolute;
}

.photo-creation-title {
  padding-left: 5vw;
  font-size: 36rpx;
  display: flex;
  flex-direction: row;
}

.photo-creation-submit {
  /* background-color: #000000; */
  border-radius: 3px;
  color: white;
  margin-right: 0;
  /* margin-left: auto; */
  padding-right: 4vw;
  padding-left: 4vw;

  display: flex;
  flex-direction: row;
}

.photo-creation-cancel {
  border-radius: 3px;
  color: white;
  font-weight: 400;
  margin-right: 5vw;
  margin-left: auto;
}

.photo-creation-actions-title {
  font-size: 30rpx;
  font-weight: 700;
  color: white;
  position: absolute;
  z-index: 3;
  top: 69;
  left: 8vw;
}

.photo-creation-actions {
  padding-left: 8vw;
  padding-right: 6vw;
  display: flex;
  flex-direction: row;
  margin-top: 2vh;
  z-index: 3;
  position: absolute;
  justify-content: end;
  width: 86.5vw;
  font-weight: 700;
  /* top: 70vh; */
  bottom: 10vh;
  font-size: 30rpx;
}

.photo-creation-description {
  color: white;
  padding-left: 8vw;
  padding-right: 8vw;
  padding-top: 3vh;
  font-size: 30rpx;
  position: absolute;
  z-index: 3;
  top: 15vh;
  line-height: 4vh;
}

.photo-creation-description-action {
  padding-left: 8vw;
  padding-right: 8vw;
  display: flex;
  flex-direction: row;
  padding-top: 2vh;
  position: absolute;
  z-index: 3;
  right: 0.5vw;
  top: 30vh;
}

.photo-creation-description-action-item {
  width: 7.6vw;
  height: 7.6vw;
  padding-left: 3.8vw;
}

.photo-creation-image {
  position: absolute;
  width: 100vw;
  height: 100vh;
  left: 0;
  top: 0;
  z-index: 1;
}

.photo-creation-image-mask {
  position: absolute;
  width: 100vw;
  height: 100vh;
  left: 0;
  top: 0;
  background-color: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(5px);
  z-index: 2;
}

.photo-creation-time-picker {
  margin-top: 10vh;
  z-index: 3;
  position: absolute;
  top: 33vh;
}

.photo-creation-location {
  padding-top: 2.5vh;
  padding-left: 8.5vw;
  padding-right: 8vw;
  display: flex;
  align-items: center;
  position: absolute;
  z-index: 3;
  top: 55vh;
}

.photo-creation-location-icon {
  width: 6.5vw;
  height: 6.5vw;
}

.photo-creation-location-text {
  grid-area: location-text;
  margin-left: 6.95vw;
  color: #A6A6A6;
}

.photo-creation-copyright {
  padding-left: 8vw;
  padding-right: 25vw;
  padding-top: 4vh;
  font-size: 22rpx;
}

.photo-creation-bottom-submit {
  margin-left: 8vw;
  margin-right: 47vw;
  width: 45vw;
  height: 5vh;
  background-color: black;
  border-radius: 5px;

  position: relative;
  top: 7vh;

  display: flex;
}

.photo-creation-top-placeholder {
  position: absolute;
  top: 0;
  width: 100vw;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0) 100%);
}

.photo-creation-unallowed-mask {
  position: absolute;
  left: 0;
  top: 0;
  height: 100vh;
  width: 100vw;
  background-color: rgba(0, 0, 0, 0.8);
  backdrop-filter: blur(10px);
  color: white;
  font-weight: 700;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  transition: opacity 0.5s ease-in-out;
  z-index: 5;
}