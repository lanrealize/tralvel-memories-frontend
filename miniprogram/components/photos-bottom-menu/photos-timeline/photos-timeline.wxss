/* components/photos-bottom-menu/photos-timeline/photos-timeline.wxss */
.tm-photos-timeline-container {
  overflow: hidden;
  width: 50vw;
}

.tm-photos-timeline-transition-root {
  display: flex;
  flex-direction: row;
  align-items: center;
  transition: transform 0.5s ease-in-out;
}

.tm-photos-timeline-transition-root > view {
  flex-shrink: 0; /* 禁止子项收缩 */
}

.tm-photos-timeline-axis {
  height: 3px;
  position: relative;
  background: 
    repeating-linear-gradient(
        to right,
        white 0px,
        white 0.8px,
        transparent 0.8px,
        transparent 5px
    );
}

.tm-photos-timeline-point {
  width: 8px;
  height: 8px;
  background-color: white;
  border-radius: 4px;
  transition: background-color 0.5s ease-in-out;
}

.tm-photos-timeline-mask {
  --stop-point: 70%;
  --start-point: 7%;
  
  mask: linear-gradient(
    to right,
    transparent 0%,
    black var(--start-point),
    black var(--stop-point),
    transparent 100%
  );
  -webkit-mask: linear-gradient(
    to right,
    transparent 0%,
    black var(--start-point),
    black var(--stop-point),
    transparent 100%
  );
}

.tm-photos-timeline-mask-end {
  --stop-point: 50%;
}