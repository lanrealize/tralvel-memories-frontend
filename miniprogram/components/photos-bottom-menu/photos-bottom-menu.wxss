/* components/photos-bottom-menu/photos-bottom-menu.wxss */
/* effect part */
.blur {
  mask-image: linear-gradient(transparent, #000, #000);
	-webkit-mask-image: linear-gradient(transparent, #000, #000);
	/* backdrop-filter: blur(1.5px); */
  width: 100%;
  height: 100%;
  overflow: visible;
  float: left;
}

.gradient {
  position: absolute;
  top: 0;
  width: 100%;
  height: 100%;
  overflow: visible;
  float: left;
  background: linear-gradient(0deg, rgba(0, 0, 0, 0.5) 0%, rgba(0, 0, 0, 0) 100%);
}

.blurred-overlay {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 2;
  width: 100vw;
  height: 35vh;
}

/* content part */
.tm-photos-bottom-menu-root {
  position: fixed;
  height: 35vh;
  width: 86vw;
  bottom: 0;

  z-index: 3;

  margin-left: 7vw;
  margin-right: 7vw;

  display: flex;
  justify-content: flex-end;
  flex-direction: column;
}

.tm-photos-bottom-menu-3rd-line {
  width: 100%;
  display: flex;
  align-items: center;
  margin-bottom: 5.5vh;
  justify-content: space-between;
  margin-left: 0.1vh;

}

.tm-photos-bottom-menu-3rd-line-word {
  display: flex;
  align-items: flex-end;
  white-space: pre-wrap;
}

.tm-photos-bottom-menu-3rd-line-word-mask {
  background-color: linear-gradient(90deg, 
  transparent 0%, 
  white 25%, 
  white 75%,
  transparent 100%) 
200% 0 / 200% 100%;
}

.tm-photos-bottom-menu-3rd-line-timeline {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.tm-photos-bottom-menu-2nd-line {
  width: calc(100% - 0.5vh);
  /* margin-left: 0.5vh; */
  display: flex;
  align-items: center;
  margin-bottom: 1.8vh;
  justify-content: space-between;
  line-height: 2.3vh;
}

