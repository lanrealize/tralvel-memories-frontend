/* components/time-picker/time-picker.wxss */
.time-picker-root {
  padding-left: 8.5vw;
  padding-right: 8vw;

  display: grid;
  grid-template-columns: 6vw 5vw 76vw;
  grid-template-areas: "picker-icon . picker-date";

  mask-image: linear-gradient(to bottom, transparent 0%,  black 30%, black 70%, transparent 100%);
  -webkit-mask-image: linear-gradient(to bottom, transparent 0%,  black 30%, black 70%, transparent 100%);
}

.fade-out-text {
  mask-image: linear-gradient(to top, transparent 0%, black 70%);
  -webkit-mask-image: linear-gradient(to top, transparent 0%, black 70%);
}

.time-picker-icon {
  grid-area: picker-icon;
  font-size: 30rpx;
  color: white;
  margin: auto;
  width: 10vw;
}

.time-picker-date {
  grid-area: picker-date;
  height: 6vh;
  width: 75vw;
}

.time-picker-column-item {
  line-height: 3vh;
  text-align: center;
  color: white;
  font-size: 30rpx;
}

.time-picker-indicator {
  height: 3vh;
  position: relative;
}

.time-picker-indicator::before {
  content: none;
  position: absolute;
  top: 0;
  border: none;
}

.time-picker-indicator::after {
  content: none;
  position: absolute;
  bottom: 0;
  border: none;
}

.time-picker-p {
  margin: auto;
  line-height: 3vh;
  color: #A6A6A6;
}

.time-picker-seperate-line {
  margin: auto;
  background-color: #A6A6A6;
  width: 0.3vw;
  height: 1.5vh;
}