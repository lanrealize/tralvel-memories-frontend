.tm-photo-root {
  width: 100vw;
  height: 100vh;
}

.tm-photo-image {
  width: 100%;
  height: 100%;
}

.tm-photo-image.animation {
  animation: show 5s ease-in-out forwards;
}

.tm-photo-loading-mask {
  background-color: black;
  position: absolute;
  width: 100vw;
  height: 100vh;
  top: 0;
  left: 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.tm-photo-loading-mask.fadeOut {
  animation: fadeOut 0.5s ease-in-out forwards;
}

.tm-photo-long-loading {
  animation: fadeIn 0.5s ease-in-out forwards;
}

@keyframes fadeOut {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
  }
}
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes show {
  from {
    transform: scale(1);
  }
  to {
    transform: scale(1.2);
  }
}
