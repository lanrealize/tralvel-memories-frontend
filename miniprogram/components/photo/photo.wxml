<view class="tm-photo-root">
  <image 
    src="{{photoUrl}}" 
    mode="aspectFill" 
    class="{{photoOrientation === 'horizontal' ? 'tm-photo-image-horizontal' : 'tm-photo-image'}} {{animationClass}}"
    bindload="onPhotoLoad">
  </image>

  <view class="tm-photo-loading-mask {{isLoading ? '' : 'fadeOut'}}">
    <!-- <busy-indicator 
      size='2' 
      style="opacity: 0;"
      showAnimation="{{isLoading}}"
      class="{{longLoading ? 'tm-photo-long-loading' : ''}}">
    </busy-indicator> -->
  </view>
</view>